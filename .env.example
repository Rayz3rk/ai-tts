# Copy to .env and fill administrator credentials for initial provisioning.
AUDIO_STUDIO_PG_ADMIN_HOST=127.0.0.1
AUDIO_STUDIO_PG_ADMIN_PORT=5432
AUDIO_STUDIO_PG_ADMIN_USER=postgres
AUDIO_STUDIO_PG_ADMIN_PASSWORD=''

# Created by: python -m audio_studio db-init
# AUDIO_STUDIO_DATABASE_URL=postgresql://audio_studio_app:YOUR_PASSWORD@127.0.0.1:5432/audio_studio

# Optional Docker connection: use a host reachable from the container.
# AUDIO_STUDIO_DOCKER_DATABASE_URL='host=host.docker.internal port=5432 dbname=audio_studio user=audio_studio_app password=YOUR_PASSWORD'
